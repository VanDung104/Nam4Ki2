# Salt & Pepper Noise
def sp_noise(image, prob): #xác suất nhiễu màu đen 
    output = np.zeros(img_gray.shape, np.uint8)
    thres = 1 - prob # xác suất nhiễu màu trắng 
    for i in range(img_gray.shape[0]): #hàng
        for j in range(img_gray.shape[1]): #cột
            rdn = random.random()
            if rdn < prob:
                output[i][j] = 0
            elif rdn > thres:
                output[i][j] = 255
            else:
                output[i][j] = image[i][j]
    return output

sp_img = sp_noise(img_gray,0.05)
plt.subplot(354)
plt.imshow(sp_img, cmap='gray') 
plt.title("Salt & pepper noise")

# Poisson Noise
def poisson_noise(image):
    noisy_img = np.zeros_like(image)
    for i in range(image.shape[0]): #hàng
        for j in range(image.shape[1]): #cột
            value = image[i][j]
            noisy_value = np.random.poisson(value)
            noisy_img[i][j] = np.clip(noisy_value, 0, 255).astype(np.uint8)
    return noisy_img

poisson_img = poisson_noise(img_gray)
plt.subplot(355)
plt.imshow(poisson_img, cmap='gray')
plt.title("Nhiễu Poisson")

def Tich_chap(img, mask):
    h, w = img_gray.shape
    img_new = np.zeros((h-2, w-2))  # Ảnh mới sẽ nhỏ hơn ảnh gốc
    for i in range(1, h-1):
        for j in range(1, w-1):
            img_new[i-1, j-1] = np.sum(img_gray[i-1:i+2, j-1:j+2] * mask)
    img_new = np.clip(img_new, 0, 255).astype(np.uint8)
    return img_new


